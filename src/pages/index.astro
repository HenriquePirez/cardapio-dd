---
import Cardapio from '../components/Cardapio.astro';
import { db } from '../lib/env';
import { cardapioCompleto, obterLojaPadrao } from '../lib/db';

const loja = await obterLojaPadrao(db());
if (!loja) return new Response('Cardápio não encontrado.', { status: 404 });
const { categorias, produtos } = await cardapioCompleto(db(), loja.id);
---

<Cardapio loja={loja} categorias={categorias} produtos={produtos} />
