---
/**
 * Login do painel — layout dividido:
 * esquerda escura com a marca + proposta; direita clara com o formulário.
 * Inspirado em padrões de produto com forte sistema tipográfico.
 */
import AplicarIdioma from '../../components/AplicarIdioma.astro';
import TemaInicial from '../../components/TemaInicial.astro';
import IndicadorCarregamento from '../../components/IndicadorCarregamento.astro';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/500-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import { contarUsuarios } from '../../lib/db';
import { db } from '../../lib/env';
import { lerUsuario } from '../../lib/session';

// Já autenticado não deve ver o formulário de login.
if (await lerUsuario(Astro)) {
  return Astro.redirect('/admin');
}

const erro = Astro.url.searchParams.get('erro');
const prox = Astro.url.searchParams.get('prox') ?? '';
const restam = Astro.url.searchParams.get('restam');
const min = Astro.url.searchParams.get('min');

// Primeiro uso -> leva direto para a criação da conta inicial
let precisaCriar = false;
try {
  precisaCriar = (await contarUsuarios(db())) === 0;
} catch {
  // Bindings ausentes em dev sem wrangler: mostra o formulário mesmo
}

const mensagensErro: Record<string, string> = {
  campos: 'Preencha o e-mail e a senha.',
  senha: `E-mail ou senha incorretos.${restam ? ` Tentativas restantes: ${restam}.` : ''}`,
  bloqueado: `Muitas tentativas erradas. Tente novamente em ${min ?? 10} min.`,
};
const mensagensOk: Record<string, string> = {
  criado: 'Conta criada! Entre com seus dados.',
  logout: 'Você saiu do painel.',
  redefinida: 'Senha redefinida! Entre com a nova senha.',
};
const erroMsg = erro ? (mensagensErro[erro] ?? null) : null;
const okParam = Astro.url.searchParams.get('ok');
const okMsg = okParam ? (mensagensOk[okParam] ?? null) : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#39282c" />
    <TemaInicial />
    <AplicarIdioma />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-myshelf-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logo-myshelf-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo-myshelf-180.png" />
    <title>Entrar — MyShelf</title>
  </head>
  <body>
    <IndicadorCarregamento />
    {precisaCriar ? (
      <main class="login-shell">
        <section class="login-art" aria-label="MyShelf">
          <div class="art-top">
            <div class="art-badge">MyShelf</div>
            <h1 class="art-h1"><span data-i18n="vitrineTitulo">Sua loja, aberta sempre.</span></h1>
            <p class="art-sub" data-i18n="vitrineSub">
              Fotos, preços e pedidos do seu cardápio na palma do cliente.
            </p>
          </div>
          <div class="art-rodape" data-i18n="vitrineRodape">MYSHELF · VITRINE DIGITAL</div>
        </section>
        <section class="login-side">
          <div class="login-box">
            <img src="/logo-myshelf-180.png" alt="MyShelf" width="72" height="72" class="login-mark" />
            <h2 class="login-h2" data-i18n="criarContaAcesso">Criar conta de acesso</h2>
            <p class="login-sub" data-i18n="primeiroUso">
              Primeiro uso: defina o login do painel.
            </p>
            <a class="ms-btn ms-btn-primary" href="/admin/criar-conta">Criar conta</a>
          </div>
        </section>
      </main>
    ) : (
      <main class="login-shell">
        <section class="login-art" aria-label="MyShelf">
          <div class="art-top">
            <div class="art-badge">MyShelf</div>
            <h1 class="art-h1"><span data-i18n="vitrineTitulo">Sua loja, aberta sempre.</span></h1>
            <p class="art-sub" data-i18n="vitrineSub">
              Fotos, preços e pedidos do seu cardápio na palma do cliente.
            </p>
          </div>
          <div class="art-rodape" data-i18n="vitrineRodape">MYSHELF · VITRINE DIGITAL</div>
        </section>

        <section class="login-side">
          <div class="login-box">
            <div class="login-logo">
              <img src="/logo-myshelf-180.png" alt="MyShelf" width="44" height="44" class="login-mark" />
              <span class="login-logo-nome">MyShelf</span>
            </div>
            <h2 class="login-h2" data-i18n="bemVindoTitulo">Bem-vindo de volta.</h2>
            <p class="login-sub" data-i18n="entrarSub">
              Entre com o e-mail e a senha do seu acesso.
            </p>

            {okMsg && <div class="ms-alert ms-alert-ok" role="status">{okMsg}</div>}
            {erroMsg && <div class="ms-alert ms-alert-erro" role="alert">{erroMsg}</div>}

            <form method="post" action="/admin/api/login" class="login-form">
              {prox && <input type="hidden" name="prox" value={prox} />}

              <div class="ms-field">
                <label for="email" data-i18n="email">E-mail</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="username"
                  required
                  inputmode="email"
                  placeholder="voce@exemplo.com"
                />
              </div>

              <div class="ms-field">
                <label for="senha" data-i18n="senha">Senha</label>
                <div class="ms-password">
                  <input
                    id="senha"
                    name="senha"
                    type="password"
                    autocomplete="current-password"
                    required
                    placeholder="••••••••"
                  />
                  <button type="button" class="ms-password-toggle" aria-label="Mostrar senha" data-i18n-aria="mostrarSenha">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                  </button>
                </div>
              </div>

              <div class="ms-row">
                <a href="/admin/recuperar-senha" data-i18n="esqueciSenha">Esqueci a senha</a>
              </div>

              <button class="ms-btn ms-btn-primary ms-btn-full" type="submit"><span data-i18n="entrar">Entrar</span></button>
            </form>
          </div>
        </section>
      </main>
    )}

    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #f5efe4;
      }

      .login-shell {
        min-height: 100dvh;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        background: #f5efe4;
      }

      /* Painel esquerdo — marca (escuro MyShelf) */
      .login-art {
        background: #39282c;
        color: #f7f4ee;
        padding: clamp(36px, 6vw, 56px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
      }

      .login-art::before {
        content: '';
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        border: 1px solid rgba(249, 223, 142, 0.14);
        top: -240px;
        right: -180px;
      }

      .login-art::after {
        content: '';
        position: absolute;
        width: 440px;
        height: 440px;
        border-radius: 50%;
        border: 1px solid rgba(249, 223, 142, 0.1);
        bottom: -200px;
        left: -140px;
      }

      .art-top {
        position: relative;
        z-index: 1;
      }

      .art-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 15px;
        border: 1px solid rgba(249, 223, 142, 0.3);
        border-radius: 999px;
        color: #f9df8e;
        background: rgba(249, 223, 142, 0.05);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 40px;
      }

      .art-h1 {
        margin: 0;
        font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
        font-weight: 500;
        font-size: clamp(46px, 5.4vw, 70px);
        line-height: 1.03;
        letter-spacing: -0.025em;
        color: #f7f4ee;
        max-width: 620px;
        text-wrap: balance;
      }

      .art-sub {
        margin: 24px 0 0;
        max-width: 440px;
        color: rgba(247, 244, 238, 0.78);
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.55;
      }

      .art-rodape {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        padding: 12px 16px;
        border: 1px solid rgba(249, 223, 142, 0.32);
        background: rgba(249, 223, 142, 0.05);
        border-radius: 4px;
        color: #f9df8e;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      /* Painel direito — formulário (claro) */
      .login-side {
        display: grid;
        place-items: center;
        padding: 42px 24px;
        min-height: 100dvh;
        background: #f5efe4;
      }

      .login-box {
        width: min(400px, 100%);
        background: transparent;
        border: 0;
        border-radius: 0;
        padding: 8px 0;
        display: flex;
        flex-direction: column;
        gap: 22px;
      }

      .login-logo {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .login-logo-nome {
        font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
        font-weight: 500;
        font-size: 28px;
        letter-spacing: -0.02em;
        color: #39282c;
      }

      .login-mark {
        width: 44px;
        height: auto;
        display: block;
      }

      .login-h2 {
        margin: 0;
        font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
        font-weight: 500;
        font-size: 42px;
        letter-spacing: -0.025em;
        line-height: 1.05;
        color: #2d2226;
      }

      .login-sub {
        margin: 0 0 4px;
        color: #685e54;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 13.5px;
        line-height: 1.55;
      }

      .ms-alert {
        border-radius: 10px;
        padding: 11px 13px;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.002em;
        line-height: 1.4;
        margin-bottom: 14px;
      }

      .ms-alert-ok {
        background: #eef4ec;
        border: 1px solid #cfe3cc;
        color: #3f6b55;
      }

      .ms-alert-erro {
        background: #fdf0ec;
        border: 1px solid #ecc4b8;
        color: #a33b35;
      }

      .login-form {
        display: grid;
        gap: 12px;
      }

      .ms-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .ms-field label {
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1.25;
        color: #39282c;
        letter-spacing: 0;
        margin-bottom: 2px;
      }

      .ms-field input,
      .ms-password input {
        width: 100%;
        min-height: 46px;
        padding: 11px 12px 11px 12px;
        border: 1px solid #e6e1d6;
        border-radius: 10px;
        background: #fbfaf6;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 15.5px;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0.008em;
        caret-color: #39282c;
        color: #2d2226;
        box-sizing: border-box;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      }

      .ms-field input::placeholder,
      .ms-password input::placeholder {
        color: #a0968c;
      }

      .ms-field input:hover,
      .ms-password input:hover {
        border-color: #d3c9bd;
      }

      .ms-field input:focus,
      .ms-password input:focus {
        outline: none;
        border-color: #39282c;
        box-shadow: 0 0 0 3px rgba(57, 40, 44, 0.14);
        background: #ffffff;
      }

      .ms-password {
        position: relative;
      }

      .ms-password input {
        padding-right: 44px;
      }

      .ms-password-toggle {
        position: absolute;
        right: 5px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        min-width: 36px;
        min-height: 34px;
        border: 0;
        background: transparent;
        color: #6b635e;
        border-radius: 8px;
        cursor: pointer;
        display: grid;
        place-items: center;
      }

      .ms-password-toggle:hover {
        background: #efece4;
        color: #2d2226;
      }

      .ms-password-toggle svg {
        width: 18px;
        height: 18px;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
      }

      .ms-row {
        display: flex;
        justify-content: flex-end;
        font-size: 13px;
      }

      .ms-row a {
        color: #39282c;
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 500;
        font-size: 13.5px;
        text-decoration: none;
        border-bottom: 1px solid #d9c7ac;
        line-height: 1.6;
        transition: color 0.15s ease, border-color 0.15s ease;
      }

      .ms-row a:hover {
        color: #2d2226;
        border-bottom-color: #39282c;
      }

      .ms-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 48px;
        padding: 12px 18px;
        border: 0;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.16s ease, transform 0.08s ease;
      }

      .ms-btn-primary {
        background: #f9df8e;
        color: #39282c;
      }

      .ms-btn-primary:hover {
        background: #f5d367;
      }

      .ms-btn-primary:focus-visible {
        outline: 2px solid #39282c;
        outline-offset: 2px;
      }

      .ms-btn-full {
        width: 100%;
      }

      @media (max-width: 900px) {
        .login-shell {
          grid-template-columns: 1fr;
        }
        .login-art {
          display: none;
        }
        .login-side {
          padding: 28px 18px;
        }
        .login-box {
          padding: 26px 22px;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const btn = document.querySelector('.ms-password-toggle');
        const input = document.getElementById('senha');
        if (!btn || !input) return;
        const adminText = { show: 'Mostrar senha', hide: 'Ocultar senha' };
        btn.addEventListener('click', () => {
          const showing = input.type === 'text';
          input.type = showing ? 'password' : 'text';
          btn.setAttribute('aria-label', showing ? adminText.show : adminText.hide);
        });
      })();
    </script>
  </body>
</html>
