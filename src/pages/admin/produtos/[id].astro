---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/ProductForm.astro';
import { db } from '../../../lib/env';
import { listarCategorias, obterProduto } from '../../../lib/db';
import { AVISOS_PRODUTO, ehSucesso } from '../../../lib/mensagens';

const { id } = Astro.params;
const msg = Astro.url.searchParams.get('msg');

const d1 = db();
const loja = Astro.locals.loja!;
const urlCardapio = loja.padrao === 1 ? '/' : `/loja/${loja.slug}`;
const produto = id ? await obterProduto(d1, loja.id, id) : null;

if (!produto) {
  return Astro.redirect('/admin/produtos?msg=nao-encontrado');
}

const categorias = await listarCategorias(d1, loja.id);
---

<AdminLayout titulo={`Editar: ${produto.nome}`}>
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="editarProduto">Editar produto</h1>
      <p class="admin-sub" data-i18n="altereDados">Altere os dados, a galeria e o link de compra.</p>
    </div>
    <a href="/admin/produtos" class="btn btn-secundario" data-i18n="produtos">← Produtos</a>
  </div>

  {msg && AVISOS_PRODUTO[msg] && (
    <div class={`aviso ${ehSucesso(msg) ? 'aviso-ok' : 'aviso-erro'}`} role={ehSucesso(msg) ? 'status' : 'alert'}>
      {AVISOS_PRODUTO[msg]}
    </div>
  )}

  <ProductForm
    urlCardapio={urlCardapio} produto={produto} categorias={categorias} />
</AdminLayout>
