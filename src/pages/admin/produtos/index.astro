---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../lib/env';
import { listarCategorias, listarProdutos } from '../../../lib/db';
import { urlMidia } from '../../../lib/env';
import { AVISOS_PRODUTO, ehSucesso } from '../../../lib/mensagens';

const d1 = db();
const categorias = await listarCategorias(d1);
const produtos = await listarProdutos(d1);

const filtro = Astro.url.searchParams.get('filtro') ?? '';
const busca = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const msg = Astro.url.searchParams.get('msg');

let lista = produtos;
if (filtro === 'destaque') lista = lista.filter((p) => p.destaque === 1);
if (filtro === 'indisponivel') lista = lista.filter((p) => p.disponivel === 0);
if (filtro === 'sem-midia') lista = lista.filter((p) => p.midia.length === 0);
if (filtro) {
  const cat = categorias.find((c) => c.id === filtro);
  if (cat) lista = lista.filter((p) => p.categoria_id === cat.id);
}
if (busca) {
  lista = lista.filter(
    (p) => p.nome.toLowerCase().includes(busca) || p.id.includes(busca),
  );
}

const nomeCat = (id: string) => categorias.find((c) => c.id === id)?.nome ?? id;
---

<AdminLayout titulo="Produtos">
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="produtos">Produtos</h1>
      <p class="admin-sub">{produtos.length} cadastrado(s).</p>
    </div>
    <div class="acoes">
      <a href="/admin/produtos/novo" class="btn btn-primario" data-i18n="novoProduto">+ Novo produto</a>
      <a href="/admin" class="btn btn-secundario" data-i18n="painel">← Painel</a>
    </div>
  </div>

  {msg && AVISOS_PRODUTO[msg] && (
    <div class={`aviso ${ehSucesso(msg) ? 'aviso-ok' : 'aviso-erro'}`} role={ehSucesso(msg) ? 'status' : 'alert'}>
      {AVISOS_PRODUTO[msg]}
    </div>
  )}

  <!-- Busca e filtros -->
  <section class="cartao filtros">
    <form method="get" action="/admin/produtos" class="busca-form">
      <input
        type="search"
        name="q"
        value={Astro.url.searchParams.get('q') ?? ''}
        placeholder="Buscar por nome…" data-i18n-ph="buscarPorNome"
        aria-label="Buscar produto" data-i18n-aria="buscarProduto"
      />
      <select name="filtro" aria-label="Filtrar" data-i18n-aria="filtrar">
        <option value="" data-i18n="todos">Todos</option>
        <option value="destaque" selected={filtro === 'destaque'} data-i18n="destaquesFiltro">Destaques</option>
        <option value="indisponivel" selected={filtro === 'indisponivel'} data-i18n="indisponiveis">Indisponíveis</option>
        <option value="sem-midia" selected={filtro === 'sem-midia'} data-i18n="semMidia">Sem mídia</option>
        {categorias.map((c) => (
          <option value={c.id} selected={filtro === c.id}>{c.nome}</option>
        ))}
      </select>
      <button class="btn btn-secundario" type="submit" data-i18n="filtrar">Filtrar</button>
      {(filtro || busca) && <a href="/admin/produtos" class="btn btn-secundario" data-i18n="limpar">Limpar</a>}
    </form>
  </section>

  <section class="cartao">
    {lista.length === 0 ? (
      <p class="vazio">
        {produtos.length === 0 ? (
          <><span data-i18n="nenhumProduto">Nenhum produto ainda.</span> <a href="/admin/produtos/novo" data-i18n="cadastrePrimeiro">Cadastre o primeiro →</a></>
        ) : (
          'Nenhum produto encontrado com esses critérios.'
        )}
      </p>
    ) : (
      <div>
        {lista.map((p) => {
          const capa = p.midia[0];
          const src = capa
            ? capa.tipo === 'video'
              ? urlMidia(capa.poster || capa.url)
              : urlMidia(capa.url)
            : '';
          return (
            <div class="linha-lista">
              {src ? (
                <img class="miniatura" src={src} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="miniatura sem"><i class="fi-br-images" aria-hidden="true"></i></span>
              )}

              <div class="cresce">
                <div class="titulo">
                  {p.nome}
                  {p.destaque === 1 && <span class="tag tag-destaque" data-i18n="destaque">destaque</span>}
                  {p.disponivel === 0 && <span class="tag tag-oculto" data-i18n="oculto">oculto</span>}
                </div>
                <div class="sub">
                  {nomeCat(p.categoria_id)} · R$ {p.preco.toFixed(2).replace('.', ',')} ·
                  {' '}{p.midia.length} mídia(s)
                </div>
              </div>

              <div class="acoes">
                <a href={`/admin/produtos/${p.id}`} class="btn btn-secundario btn-sm" data-i18n="editar">Editar</a>
                <form method="post" action="/admin/api/produtos/excluir" data-excluir>
                  <input type="hidden" name="id" value={p.id} />
                  <button type="submit" class="btn btn-perigo btn-sm" data-i18n="excluir">Excluir</button>
                </form>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </section>

  <script>
    document.addEventListener('submit', (e) => {
      const form = e.target;
      if (!(form instanceof HTMLFormElement) || !form.matches('[data-excluir]')) return;
      const nome = form.closest('.linha-lista')?.querySelector('.titulo')?.textContent?.trim();
      if (!confirm(`Excluir o produto "${nome}"? As mídias também serão removidas da lista.`)) {
        e.preventDefault();
      }
    });
  </script>
</AdminLayout>

<style>
  .filtros {
    padding: 14px;
  }

  .busca-form {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
  }

  .busca-form input[type='search'] {
    flex: 1;
    min-width: 180px;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    font-size: 15px;
    font-family: inherit;
    box-sizing: border-box;
  }

  .busca-form select {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    font-size: 15px;
    font-family: inherit;
    background: var(--adm-card);
  }

  .busca-form input:focus,
  .busca-form select:focus {
    outline: 2px solid #ff7a3d;
    outline-offset: 1px;
    border-color: transparent;
  }

  .acoes form {
    margin: 0;
  }

  .tag {
    display: inline-block;
    margin-left: 7px;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }

  .tag-destaque {
    background: #fef3c7;
    color: #b45309;
  }

  .tag-oculto {
    background: #f3f4f6;
    color: #6b7280;
  }

  .miniatura.sem {
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    background: #f3f4f6;
  }

  .vazio a {
    color: #ff5e1a;
    font-weight: 500;
  }
</style>
