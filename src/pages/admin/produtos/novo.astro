---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/ProductForm.astro';
import { db } from '../../../lib/env';
import { listarCategorias } from '../../../lib/db';
import { AVISOS_PRODUTO, ehSucesso } from '../../../lib/mensagens';

const categorias = await listarCategorias(db());
const msg = Astro.url.searchParams.get('msg');
---

<AdminLayout titulo="Novo produto">
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1">Novo produto</h1>
      <p class="admin-sub">Preencha os dados e envie as fotos/vídeos.</p>
    </div>
    <a href="/admin/produtos" class="btn btn-secundario">← Produtos</a>
  </div>

  {msg && AVISOS_PRODUTO[msg] && (
    <div class={`aviso ${ehSucesso(msg) ? 'aviso-ok' : 'aviso-erro'}`} role={ehSucesso(msg) ? 'status' : 'alert'}>
      {AVISOS_PRODUTO[msg]}
    </div>
  )}

  {categorias.length === 0 && (
    <div class="aviso aviso-erro">
      Você precisa de ao menos <strong>uma categoria</strong> antes de cadastrar produtos.
      <a href="/admin/categorias"> Criar categoria →</a>
    </div>
  )}

  <ProductForm categorias={categorias} />
</AdminLayout>
