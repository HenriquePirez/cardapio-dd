---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/ProductForm.astro';
import { db } from '../../../lib/env';
import { listarCategorias } from '../../../lib/db';
import { AVISOS_PRODUTO, ehSucesso } from '../../../lib/mensagens';

const loja = Astro.locals.loja!;
const urlCardapio = loja.padrao === 1 ? '/' : `/loja/${loja.slug}`;
const categorias = await listarCategorias(db(), loja.id);
const msg = Astro.url.searchParams.get('msg');
---

<AdminLayout titulo="Novo produto">
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="novoProdutoTitulo">Novo produto</h1>
      <p class="admin-sub" data-i18n="preenchaDados">Preencha os dados e envie as fotos/vídeos.</p>
    </div>
    <a href="/admin/produtos" class="btn btn-secundario" data-i18n="produtos">← Produtos</a>
  </div>

  {msg && AVISOS_PRODUTO[msg] && (
    <div class={`aviso ${ehSucesso(msg) ? 'aviso-ok' : 'aviso-erro'}`} role={ehSucesso(msg) ? 'status' : 'alert'}>
      {AVISOS_PRODUTO[msg]}
    </div>
  )}

  {categorias.length === 0 && (
    <div class="aviso aviso-erro">
      <span data-i18n="precisaAoMenos">Você precisa de ao menos</span>
      <strong data-i18n="umaCategoria">uma categoria</strong>
      <span data-i18n="antesProdutos">antes de cadastrar produtos.</span>
      <a href="/admin/categorias" data-i18n="criarCategoria">Criar categoria →</a>
    </div>
  )}

  <ProductForm
    urlCardapio={urlCardapio} categorias={categorias} />
</AdminLayout>
