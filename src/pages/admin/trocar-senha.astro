---
/**
 * Troca de senha do usuário logado (rota autenticada):
 * três campos, e salvar move para o login. Senha atual obrigatória.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { lerUsuario } from '../../lib/session';

const sessao = await lerUsuario(Astro);
if (!sessao) return Astro.redirect('/admin/login');

const erro = Astro.url.searchParams.get('erro');
const mensagens: Record<string, string> = {
  campos: 'Preencha todos os campos.',
  'senha-atual': 'A senha atual está incorreta.',
  divergentes: 'As senhas não coincidem.',
};
const erroMsg = erro ? (mensagens[erro] ?? erro) : null;
---

<AdminLayout titulo="Alterar senha" descricao="Trocar a senha da conta de acesso ao painel">
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="alterarSenha">Alterar senha</h1>
      <p class="admin-sub">Informe a senha atual e escolha uma nova. Ao salvar, será necessário entrar de novo.</p>
    </div>
    <a href="/admin/perfil" class="btn btn-secundario" data-i18n="voltarPainel">← Perfil</a>
  </div>

  {erroMsg && <div class="aviso aviso-erro" role="alert">{erroMsg}</div>}

  <div class="cartao">
    <form method="post" action="/admin/api/trocar-senha">
      <div class="grade-campos">
        <div class="campo">
          <label for="senha_atual" data-i18n="senhaAtual">Senha atual</label>
          <input
            id="senha_atual"
            name="senha_atual"
            type="password"
            required
            autocomplete="current-password"
          />
        </div>

        <div class="campo">
          <label for="senha_nova" data-i18n="novaSenha">Nova senha</label>
          <input
            id="senha_nova"
            name="senha_nova"
            type="password"
            required
            minlength="10"
            autocomplete="new-password"
            placeholder="mínimo 10 caracteres"
          />
        </div>

        <div class="campo">
          <label for="senha_nova2" data-i18n="confirmarSenha">Confirmar nova senha</label>
          <input
            id="senha_nova2"
            name="senha_nova2"
            type="password"
            required
            minlength="10"
            autocomplete="new-password"
            placeholder="repita a senha"
          />
        </div>
      </div>

      <button class="btn btn-primario" type="submit" data-i18n="trocarSenha">Trocar senha</button>
    </form>
  </div>
</AdminLayout>
