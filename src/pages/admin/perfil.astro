---
/**
 * Perfil do usuário logado: nome, e-mail e troca de senha.
 * Cada cartão é um form próprio; o endpoint /admin/api/perfil escolhe o fluxo
 * pela presença do campo senha_atual.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Toast from '../../components/Toast.astro';
import { obterUsuarioPorId } from '../../lib/db';
import { db } from '../../lib/env';
import { lerUsuario } from '../../lib/session';

const sessao = await lerUsuario(Astro);
if (!sessao) return Astro.redirect('/admin/login');

const usuario = (await obterUsuarioPorId(db(), sessao.id)) ?? sessao;

const ok = Astro.url.searchParams.get('ok');
const erro = Astro.url.searchParams.get('erro');

const mensagens: Record<string, string> = {
  campos: 'Preencha todos os campos.',
  email: 'Não foi possível enviar o e-mail. Tente novamente em instantes.',
  'email-config': 'O envio de e-mail não está configurado neste ambiente.',
  'email-existente': 'Este e-mail já é usado por outra conta.',
  'senha-atual': 'A senha atual está incorreta.',
  divergentes: 'As senhas não coincidem.',
};
const erroMsg = erro ? (mensagens[erro] ?? erro) : null;
---

<AdminLayout titulo="Perfil" descricao="Dados da conta de acesso ao painel">
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="perfil">Perfil</h1>
      <p class="admin-sub" data-i18n="perfilSub">Seus dados de acesso ao painel.</p>
    </div>
    <a href="/admin" class="btn btn-secundario" data-i18n="voltarPainel">← Painel</a>
  </div>

  {ok && (
    <Toast
      tipo="ok"
      texto={
        ok === 'senha'
          ? 'Senha alterada com sucesso.'
          : ok === 'enviado'
            ? `Link de redefinição enviado para ${usuario.email}. Confira sua caixa de entrada.`
            : 'Perfil atualizado.'
      }
    />
  )}
  {erroMsg && <Toast tipo="erro" texto={erroMsg} />}

  <div class="cartao">
    <h2 data-i18n="dadosConta">Dados da conta</h2>
    <form method="post" action="/admin/api/perfil">
      <div class="grade-campos">
        <div class="campo">
          <label for="nome" data-i18n="nome">Nome</label>
          <input
            id="nome"
            name="nome"
            type="text"
            required
            autocomplete="name"
            value={usuario.nome}
          />
        </div>

        <div class="campo">
          <label for="email" data-i18n="email">E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="username"
            inputmode="email"
            value={usuario.email}
          />
          <small data-i18n="emailAjuda">É o seu login no painel.</small>
        </div>
      </div>

      <button class="btn btn-primario" type="submit" data-i18n="salvar">Salvar</button>
    </form>
  </div>

  <div class="cartao">
    <h2 data-i18n="alterarSenha">Alterar senha</h2>
    <p class="perfil-aviso">
      Enviaremos um link de redefinição para <strong>{usuario.email}</strong>. Vale por
      <strong>1 hora</strong> e só pode ser usado uma vez.
    </p>
    <div class="perfil-acoes">
      <form method="post" action="/admin/api/recuperar-senha">
        <input type="hidden" name="email" value={usuario.email} />
        <input type="hidden" name="prox" value="/admin/perfil?ok=enviado" />
        <button class="btn btn-primario" type="submit" data-i18n="alterarSenha">Alterar senha</button>
      </form>
    </div>
  </div>
</AdminLayout>

<style>
  .perfil-acoes {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .perfil-aviso {
    margin: 0 0 18px;
    color: var(--adm-dim);
    font-size: 0.92rem;
    line-height: 1.5;
  }
</style>
