---
/**
 * Dashboard de usuários (admin master).
 * Lista todos os usuários do painel com quantidade de lojas e status ativo/inativo.
 * Permite ativar/desativar usuários (soft delete). Somente o admin master acessa.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listarUsuariosComLojas } from '../../lib/db';
import { db } from '../../lib/env';
import { lerUsuario } from '../../lib/session';

const d1 = db();
const usuario = await lerUsuario(Astro);

if (!usuario || !(Astro.locals as { usuarioMaster?: boolean }).usuarioMaster) {
  return new Response(null, { status: 403, headers: { 'Content-Type': 'text/plain' } });
}

const usuarios = await listarUsuariosComLojas(d1);

const totalUsuarios = usuarios.length;
const totalAtivos = usuarios.filter((u) => u.ativo === 1).length;
const totalInativos = usuarios.filter((u) => u.ativo === 0).length;
const totalLojas = usuarios.reduce((acc, u) => acc + u.qtd_lojas, 0);

function formatarData(iso: string | null | undefined): string {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    return d.toLocaleString('pt-BR', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return '—';
  }
}
---

<AdminLayout titulo="Usuários" descricao="Controle de acessos ao painel">
  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="usuarios">Usuários</h1>
      <p class="admin-sub" data-i18n="usuariosSub">Quem tem acesso ao painel e quantas lojas administra.</p>
    </div>
    <div class="acoes">
      <a href="/admin" class="btn btn-secundario" data-i18n="voltarPainel">← Painel</a>
    </div>
  </div>

  <div class="grade-stats">
    <a class="stat">
      <span class="stat-valor">{totalUsuarios}</span>
      <span class="stat-rotulo" data-i18n="totalUsuarios">Usuários</span>
    </a>
    <a class="stat">
      <span class="stat-valor">{totalAtivos}</span>
      <span class="stat-rotulo" data-i18n="ativos">Ativos</span>
    </a>
    <a class="stat">
      <span class="stat-valor">{totalInativos}</span>
      <span class="stat-rotulo" data-i18n="inativos">Inativos</span>
    </a>
    <a class="stat">
      <span class="stat-valor">{totalLojas}</span>
      <span class="stat-rotulo" data-i18n="totalLojas">Lojas</span>
    </a>
  </div>

  <div class="cartao">
    <table class="tabela-usuarios">
      <thead>
        <tr>
          <th scope="col" data-i18n="usuario">Usuário</th>
          <th scope="col" data-i18n="email">E‑mail</th>
          <th scope="col" data-i18n="criadoEm">Criado em</th>
          <th scope="col" data-i18n="lojas">Lojas</th>
          <th scope="col" data-i18n="status">Status</th>
          <th scope="col" data-i18n="aceite">Aceite legal</th>
          <th scope="col" style="width: 140px" data-i18n="acao">Ação</th>
        </tr>
      </thead>
      <tbody>
        {usuarios.length === 0 ? (
          <tr>
            <td colspan="7" class="vazio">
              <span data-i18n="nenhumUsuario">Nenhum usuário cadastrado.</span>
            </td>
          </tr>
        ) : (
          usuarios.map((u) => {
            const ativo = u.ativo === 1;
            const ehEu = u.id === usuario.id;
            return (
              <tr class="linha-usuario">
                <td class="cresce">
                  <span class="titulo-usuario">{u.nome}</span>
                </td>
                <td><a href={`mailto:${u.email}`}>{u.email}</a></td>
                <td class="celula-data">{formatarData(u.criado_em)}</td>
                <td>
                  <span class="badge-lojas">{u.qtd_lojas}</span>
                </td>
                <td>
                  <span
                    class={`badge-status ${ativo ? 'badge-ativo' : 'badge-inativo'}`}
                    data-i18n={ativo ? 'ativo' : 'inativo'}
                  >
                    {ativo ? 'Ativo' : 'Inativo'}
                  </span>
                </td>
                <td class="celula-data">
                  {u.aceite_em ? `${formatarData(u.aceite_em)}` : '—'}
                </td>
                <td class="acoes">
                  {!ehEu && (
                    <form method="post" action="/admin/api/usuarios/toggle-ativo" class="form-toggle">
                      <input type="hidden" name="id" value={u.id} />
                      <input type="hidden" name="ativo" value={ativo ? '0' : '1'} />
                      <button
                        class={`btn btn-sm ${ativo ? 'btn-perigo' : 'btn-primario'}`}
                        type="submit"
                        data-i18n={ativo ? 'desativar' : 'ativar'}
                      >
                        {ativo ? 'Desativar' : 'Ativar'}
                      </button>
                    </form>
                  )}
                  {ehEu && (
                    <span class="badge-lojas" style="background: transparent; color: var(--adm-dim); font-size: 0.78rem;">
                      Você
                    </span>
                  )}
                </td>
              </tr>
            );
          })
        )}
      </tbody>
    </table>
    {usuarios.length > 0 && (
      <p class="admin-sub" style="margin:10px 0 0">
        Total: {usuarios.length} usuário(s) · {totalAtivos} ativo(s) · {totalInativos} inativo(s).
      </p>
    )}
  </div>
</AdminLayout>

<style>
  .grade-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    .grade-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    background: var(--adm-card);
    border: 1px solid var(--adm-border);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .stat:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.07);
  }

  .stat-valor {
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1;
    color: #ff5e1a;
    letter-spacing: -0.03em;
  }

  .stat-rotulo {
    font-size: 0.82rem;
    color: #6b7280;
    font-weight: 500;
  }

  .tabela-usuarios {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .tabela-usuarios th {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 2px solid var(--adm-border);
    color: var(--adm-dim);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tabela-usuarios td {
    padding: 12px;
    border-bottom: 1px solid var(--adm-border);
    vertical-align: middle;
    color: var(--adm-text);
  }

  .tabela-usuarios tr:last-child td {
    border-bottom: 0;
  }

  .celula-data {
    white-space: normal;
  }

  .titulo-usuario {
    display: block;
    font-weight: 500;
    color: var(--adm-text);
  }

  .badge-lojas {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--adm-elev);
    color: var(--adm-text);
    font-size: 0.82rem;
    font-weight: 500;
    min-width: 28px;
    text-align: center;
    white-space: nowrap;
  }

  .badge-status {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .badge-ativo {
    background: #e7f7ee;
    color: #15803d;
  }

  .badge-inativo {
    background: #fbeaea;
    color: #b91c1c;
  }

  .tabela-usuarios a {
    color: var(--cor-preco);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .linha-usuario td a:hover {
    text-decoration: none;
  }

  .form-toggle {
    display: flex;
    gap: 6px;
  }

  .form-toggle .btn-sm {
    padding: 6px 10px;
    font-size: 0.82rem;
  }
</style>
