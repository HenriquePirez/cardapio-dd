---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { contarUsuarios } from '../../lib/db';
import { db } from '../../lib/env';

const erro = Astro.url.searchParams.get('erro');

let jaExiste = false;
let semBind = false;
try {
  jaExiste = (await contarUsuarios(db())) > 0;
} catch {
  semBind = true;
}

// Já há conta -> manda pro login
if (jaExiste) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout titulo="Criar conta">
  <div class="caixa-login">
    <div class="marca"><i class="fi-br-lock" aria-hidden="true"></i></div>
    <h1 class="titulo">Criar conta do painel</h1>
    <p class="sub">
      Primeiro uso. Esta será a única conta de acesso — você poderá compartilhar
      as credenciais com até 2 pessoas de confiança.
    </p>

    {semBind && (
      <div class="aviso aviso-erro">
        Bindings do Cloudflare (D1/KV) indisponíveis no ambiente atual.
        Rode com <code>npx wrangler dev</code> ou configure o <code>wrangler.jsonc</code>.
      </div>
    )}

    {erro && (
      <div class="aviso aviso-erro" role="alert">
        {erro === 'campos' && 'Preencha todos os campos.'}
        {erro === 'divergentes' && 'As senhas não coincidem.'}
        {erro === 'token' && 'Código de configuração inválido.'}
        {erro !== 'campos' && erro !== 'divergentes' && erro !== 'token' && erro}
      </div>
    )}

    <form method="post" action="/admin/api/criar-conta" class="form">
      <div class="campo">
        <label for="token">Código de configuração</label>
        <input
          id="token"
          name="token"
          type="password"
          required
          autocomplete="off"
          placeholder="valor de SETUP_TOKEN"
        />
        <small>
          Segredo definido com <code>npx wrangler secret put SETUP_TOKEN</code>. Sem ele a
          criação de conta fica desativada.
        </small>
      </div>

      <div class="campo">
        <label for="nome">Seu nome</label>
        <input id="nome" name="nome" type="text" required autocomplete="name" placeholder="Nome" />
      </div>

      <div class="campo">
        <label for="email">E-mail (login)</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="username"
          inputmode="email"
          placeholder="voce@exemplo.com"
        />
      </div>

      <div class="campo">
        <label for="senha">Senha</label>
        <input
          id="senha"
          name="senha"
          type="password"
          required
          minlength="6"
          autocomplete="new-password"
          placeholder="mínimo 10 caracteres"
        />
        <small>Mínimo 10 caracteres.</small>
      </div>

      <div class="campo">
        <label for="senha2">Confirmar senha</label>
        <input
          id="senha2"
          name="senha2"
          type="password"
          required
          autocomplete="new-password"
          placeholder="repita a senha"
        />
      </div>

      <button class="btn btn-primario btn-largo" type="submit">Criar conta e entrar</button>
    </form>

    <p class="rodape"><a href="/admin/login">← Já tenho uma conta</a></p>
  </div>
</AdminLayout>

<style>
  .caixa-login {
    max-width: 420px;
    margin: 4vh auto 0;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 30px 26px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    text-align: center;
  }

  .marca {
    font-size: 2rem;
    margin-bottom: 4px;
  }

  .titulo {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .sub {
    margin: 0 0 22px;
    color: #6b7280;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .form {
    text-align: left;
  }

  .btn-largo {
    width: 100%;
    margin-top: 6px;
    padding-top: 13px;
    padding-bottom: 13px;
  }

  .rodape {
    margin: 20px 0 0;
    font-size: 0.86rem;
  }

  .rodape a {
    color: #ea580c;
    font-weight: 500;
  }

  .rodape a:hover {
    text-decoration: underline;
  }

  code {
    background: #fee2e2;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.82em;
  }
</style>
