---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Preferencias from '../components/Preferencias.astro';
import PedidoDialog from '../components/PedidoDialog.astro';
import Gallery from '../components/Gallery.astro';
import IconeCategoria from '../components/IconeCategoria.astro';
import RodapeLegal from '../components/RodapeLegal.astro';
import { urlMidia } from '../lib/env';
import type { Categoria, Loja, Midia, Produto } from '../lib/db';
import { formatarPreco } from '../config';
import { normalizarModalidade, urlCompraValida, type Modalidade } from '../lib/pedido';

interface Props {
  loja: Loja;
  categorias: Categoria[];
  produtos: (Produto & { midia: Midia[] })[];
}

const { loja, categorias, produtos } = Astro.props;

const destaques = produtos.filter((p) => p.destaque === 1);
// Evita repetir o catálogo inteiro quando todos os produtos já são destaque.
const mostrarDestaques = destaques.length > 0 && destaques.length < produtos.length;

// Agrupa produtos por categoria, preservando a ordem das categorias
const porCategoria = new Map<string, typeof produtos>();
for (const cat of categorias) {
  const lista = produtos.filter((p) => p.categoria_id === cat.id);
  if (lista.length) porCategoria.set(cat.id, lista);
}

// Payload de galerias para o lightbox (URLs já resolvidas)
const galerias: Record<
  string,
  {
    nome: string;
    compraDisponivel: boolean;
    itens: Array<{
      tipo: 'imagem' | 'video';
      src: string;
      full?: string;
      poster?: string;
      alt?: string;
    }>;
  }
> = {};

// Nome do produto é melhor alt do que o nome do arquivo ("crostini-2").
function altDe(alt: string | null, nome: string, indice: number): string {
  const texto = (alt ?? '').trim();
  const pareceArquivo = !texto || (!/\s/.test(texto) && /[-_.\d]/.test(texto));
  return pareceArquivo ? `${nome} — foto ${indice + 1}` : texto;
}

const comprasValidas: Record<string, boolean> = {};
for (const p of produtos) {
  const modalidade = normalizarModalidade(p.modalidade) ?? 'ambos';
  // Local e ambos ainda podem vender no totem; só retirada exige link válido.
  comprasValidas[p.id] = modalidade !== 'retirada' || urlCompraValida(p.comprar_url);
}

for (const p of produtos) {
  galerias[p.id] = {
    nome: p.nome,
    compraDisponivel: comprasValidas[p.id] ?? false,
    itens: p.midia.map((m, i) =>
      m.tipo === 'imagem'
        ? {
            tipo: 'imagem' as const,
            src: urlMidia(m.url),
            full: urlMidia(m.full || m.url),
            alt: altDe(m.alt, p.nome, i),
          }
        : {
            tipo: 'video' as const,
            src: urlMidia(m.url),
            poster: urlMidia(m.poster || ''),
            alt: altDe(m.alt, p.nome, i),
          },
    ),
  };
}

// Fluxo de compra: URL aberta só na retirada; local mostra o aviso do totem.
const pedidos: Record<string, { url: string; modalidade: Modalidade; nome: string }> = {};
for (const p of produtos) {
  pedidos[p.id] = {
    url: p.comprar_url ?? '',
    modalidade: normalizarModalidade(p.modalidade) ?? 'ambos',
    nome: p.nome,
  };
}

// Capa do card (thumbnail). Para vídeo, usa o poster.
function capaDe(p: (typeof produtos)[number]) {
  const m = p.midia[0];
  if (!m) return undefined;
  if (m.tipo === 'imagem') {
    return { url: urlMidia(m.url), alt: altDe(m.alt, p.nome, 0), tipo: 'imagem' as const };
  }
  return {
    url: urlMidia(m.poster || m.url),
    poster: urlMidia(m.poster || ''),
    alt: altDe(m.alt, p.nome, 0),
    tipo: 'video' as const,
  };
}

const logoSrc = loja.logo_chave ? urlMidia(loja.logo_chave) : '/logo-donadora.png';
const slogan = loja.slogan || 'O sabor que começa pelos olhos';
---

<BaseLayout loja={loja}>
  <header class="topo">
    <div class="container topo-inner">
      <img class="topo-logo" src={logoSrc} alt={`Logo ${loja.nome}`} width="568" height="573" />
      <div class="topo-textos">
        <h1 class="topo-titulo">{loja.nome}</h1>
        <p class="topo-sub" data-i18n="tagline">{slogan}</p>
      </div>
      <Preferencias />
    </div>
  </header>

  <!-- Navegação rápida por categoria -->
  <nav class="atalhos" aria-label="Categorias" data-i18n-aria="categorias">
    <div class="container atalhos-scroll">
      {categorias
        .filter((cat) => porCategoria.has(cat.id))
        .map((cat) => (
        <a class="atalho" href={`#${cat.id}`}>
          <IconeCategoria icone={cat.icone} />
          <span data-cat={cat.id} data-cat-pt={cat.nome}>{cat.nome}</span>
        </a>
      ))}
    </div>
  </nav>

  <main class="container" id="conteudo" tabindex="-1">
    {produtos.length === 0 && (
      <div class="vazio">
        <p>
          <span data-i18n="cardapioVazio">Cardápio em construção. Volte em breve!</span>
          <i class="fi-br-burger-alt" aria-hidden="true"></i>
        </p>
      </div>
    )}

    <!-- Destaques -->
    {mostrarDestaques && (
      <section class="secao" aria-labelledby="destaques-h">
        <h2 class="secao-titulo" id="destaques-h" data-i18n="destaques">Destaques</h2>
        <div class="destaque-scroll">
          {destaques.map((p) => {
            const capa = capaDe(p);
            return (
              <button
                class="destaque"
                type="button"
                data-abrir-galeria={p.id}
                aria-label={`Ver ${p.nome}`}
              >
                <img
                  src={capa?.url}
                  alt={capa?.alt || p.nome}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="480"
                />
                <span class="destaque-info">
                  <span class="destaque-nome">{p.nome}</span>
                  <span class="destaque-preco">{formatarPreco(p.preco_centavos / 100)}</span>
                </span>
              </button>
            );
          })}
        </div>
      </section>
    )}

    <!-- Categorias + produtos -->
    {categorias.map((cat) => {
      const lista = porCategoria.get(cat.id);
      if (!lista?.length) return null;
      return (
        <section class="secao" id={cat.id} aria-labelledby={`h-${cat.id}`}>
          <div class="secao-cab">
            <h2 class="secao-titulo" id={`h-${cat.id}`}>
              <IconeCategoria icone={cat.icone} />
              <span data-cat={cat.id} data-cat-pt={cat.nome}>{cat.nome}</span>
            </h2>
            {cat.descricao && (
              <p class="secao-desc">
                <span data-cat-desc={cat.id} data-cat-pt={cat.descricao}>{cat.descricao}</span>
              </p>
            )}
          </div>
          <div class="grade">
            {lista.map((p) => (
              <ProductCard
                id={p.id}
                nome={p.nome}
                preco={p.preco_centavos / 100}
                descricao={p.descricao ?? undefined}
                capa={capaDe(p)}
                totalMidia={p.midia.length}
                compraDisponivel={comprasValidas[p.id] ?? false}
              />
            ))}
          </div>
        </section>
      );
    })}
  </main>

  <footer class="rodape">
    <div class="container">
      <p>{loja.nome} · <span data-i18n="cardapioDigital">Cardápio digital</span></p>
      <RodapeLegal />
      <p class="rodape-creditos">
        <span data-i18n="iconesPor">Ícones por</span>
        <a href="https://www.flaticon.com/br/" target="_blank" rel="noopener noreferrer">Flaticon</a>
      </p>
    </div>
  </footer>

  <PedidoDialog pedidos={pedidos} />
  <Gallery galerias={galerias} />
</BaseLayout>

<script>
  const topo = document.querySelector<HTMLElement>('.topo');
  const atalhos = document.querySelector<HTMLElement>('.atalhos');
  const raiz = document.documentElement;
  const secoes = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.atalho')];

  function ativar(id: string): void {
    for (const link of links) {
      const ativo = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('ativo', ativo);
      if (ativo) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
  }

  function atualizarAtiva(): void {
    if (!secoes.length) return;
    const corte = (topo?.offsetHeight ?? 0) + (atalhos?.offsetHeight ?? 0) + 12;
    let atual = secoes[0]?.id ?? '';
    for (const secao of secoes) {
      if (secao.getBoundingClientRect().top <= corte) atual = secao.id;
    }
    if (atual) ativar(atual);
  }

  function medir(): void {
    if (topo) raiz.style.setProperty('--topo-altura', `${topo.offsetHeight}px`);
    if (atalhos) raiz.style.setProperty('--atalhos-altura', `${atalhos.offsetHeight}px`);
    atualizarAtiva();
  }

  let quadro = 0;
  addEventListener(
    'scroll',
    () => {
      if (quadro) return;
      quadro = requestAnimationFrame(() => {
        quadro = 0;
        atualizarAtiva();
      });
    },
    { passive: true },
  );
  addEventListener('resize', medir);
  for (const link of links) {
    link.addEventListener('click', () => ativar(link.getAttribute('href')?.slice(1) ?? ''));
  }
  if (topo) new ResizeObserver(medir).observe(topo);
  if (atalhos) new ResizeObserver(medir).observe(atalhos);
  medir();
</script>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--verde);
    border-bottom: 3px solid var(--laranja);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .topo-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: calc(10px + env(safe-area-inset-top));
    padding-bottom: 10px;
  }

  .topo-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .topo-textos {
    min-width: 0;
  }

  .topo-titulo {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .topo-sub {
    margin: 2px 0 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .atalhos {
    position: sticky;
    top: var(--topo-altura, calc(77px + env(safe-area-inset-top)));
    z-index: 40;
    background: var(--veu);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .atalhos-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-top: 10px;
    padding-bottom: 10px;
    scrollbar-width: none;
  }

  .atalhos-scroll::-webkit-scrollbar {
    display: none;
  }

  .atalho {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    flex-shrink: 0;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .atalho:active,
  .atalho.ativo {
    background: var(--laranja-aa);
    border-color: var(--laranja-aa);
    color: #fff;
  }

  #conteudo {
    scroll-margin-top: calc(var(--topo-altura, 77px) + 8px);
  }

  .secao {
    padding-top: 26px;
    scroll-margin-top: calc(var(--topo-altura, 77px) + var(--atalhos-altura, 60px) + 12px);
  }

  .secao-cab {
    margin-bottom: 14px;
  }

  .secao-titulo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--cor-titulo);
  }

  .secao-desc {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .destaque-scroll {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    margin-top: 14px;
    padding-bottom: 6px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .destaque-scroll::-webkit-scrollbar {
    display: none;
  }

  .destaque {
    position: relative;
    flex: 0 0 74%;
    max-width: 300px;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
    scroll-snap-align: start;
  }

  .destaque img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .destaque-info {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 26px 12px 12px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.78) 60%,
      transparent 100%
    );
    color: #fff;
    text-align: left;
  }

  .destaque-nome {
    font-weight: 500;
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .destaque-preco {
    flex-shrink: 0;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .grade {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .vazio {
    padding: 70px 0;
    text-align: center;
    color: var(--text-dim);
  }

  .vazio p {
    margin: 0;
    font-size: 1.05rem;
  }

  .rodape {
    margin-top: 40px;
    padding: 26px 0 calc(30px + env(safe-area-inset-bottom));
    background: var(--verde);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.82rem;
    text-align: center;
  }

  .rodape-creditos {
    margin: 6px 0 0;
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .rodape-creditos a {
    display: inline-block;
    padding: 4px 0;
    text-decoration: underline;
  }

  @media (min-width: 560px) {
    .grade {
      grid-template-columns: repeat(2, 1fr);
    }

    .destaque {
      flex-basis: 46%;
    }
  }

  @media (min-width: 900px) {
    .container {
      max-width: 1024px;
      padding-left: 24px;
      padding-right: 24px;
    }

    .topo-titulo {
      font-size: 1.65rem;
    }

    .topo-sub {
      font-size: 0.92rem;
    }

    .secao {
      padding-top: 36px;
    }

    .secao-titulo {
      font-size: 1.35rem;
    }

    .destaque {
      flex-basis: 31%;
      max-width: 360px;
    }

    /* Uma categoria com um produto ocupa a largura; o card vira linha. */
    .grade {
      grid-template-columns: 1fr;
    }
  }
</style>
