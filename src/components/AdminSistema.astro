---
/**
 * Painel enxuto do admin master: visão geral + gestão de usuários no mesmo lugar.
 * Sem produtos, categorias, loja ou cardápio — quem administra lojas é outro papel.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import Toast from '../components/Toast.astro';
import type { UsuarioResumo } from '../lib/db';

interface Props {
  usuarios: UsuarioResumo[];
  usuarioId: string;
}

const { usuarios, usuarioId } = Astro.props;
const ok = Astro.url.searchParams.get('ok');
const erro = Astro.url.searchParams.get('erro');

const totalUsuarios = usuarios.length;
const totalAtivos = usuarios.filter((u) => u.ativo === 1).length;
const totalInativos = usuarios.filter((u) => u.ativo === 0).length;
const totalLojas = usuarios.reduce((acc, u) => acc + u.qtd_lojas, 0);

const toastOk: Record<string, string> = {
  ativado: 'Usuário ativado novamente — acesso de volta ao painel.',
  desativado: 'Usuário desativado — acesso removido. Ele não entra mais no painel.',
};
const toastErro: Record<string, string> = {
  id: 'ID do usuário ausente.',
  'nao-encontrado': 'Usuário não encontrado.',
  'proprio-master': 'Você não pode desativar a sua própria conta master.',
};
const okMsg = ok ? (toastOk[ok] ?? null) : null;
const erroMsg = erro ? (toastErro[erro] ?? erro) : null;

function formatarData(iso: string | null | undefined): string {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleString('pt-BR', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return '—';
  }
}
---

<AdminLayout titulo="Sistema" descricao="Administração do sistema e dos acessos ao painel">
  {okMsg && <Toast tipo="ok" texto={okMsg} />}
  {erroMsg && <Toast tipo="erro" texto={erroMsg} />}

  <div class="barra-acoes">
    <div>
      <h1 class="admin-h1" data-i18n="sistemaTitulo">Sistema</h1>
      <p class="admin-sub" data-i18n="sistemaSub">Administração do sistema e dos acessos ao painel.</p>
    </div>
  </div>

  <div class="grade-stats">
    <div class="stat">
      <span class="stat-valor">{totalUsuarios}</span>
      <span class="stat-rotulo" data-i18n="totalUsuarios">Usuários</span>
    </div>
    <div class="stat">
      <span class="stat-valor">{totalAtivos}</span>
      <span class="stat-rotulo" data-i18n="ativos">Ativos</span>
    </div>
    <div class="stat">
      <span class="stat-valor">{totalInativos}</span>
      <span class="stat-rotulo" data-i18n="inativos">Inativos</span>
    </div>
    <div class="stat">
      <span class="stat-valor">{totalLojas}</span>
      <span class="stat-rotulo" data-i18n="totalLojas">Lojas</span>
    </div>
  </div>

  <div class="cartao">
    <div class="busca-usuarios">
      <div class="campo-busca">
        <label for="busca" class="sr-only" data-i18n="buscarUsuarios">Buscar usuários</label>
        <input
          id="busca"
          type="search"
          placeholder="Buscar nome ou e-mail…"
          autocomplete="off"
          data-i18n-ph="buscarUsuariosPlaceholder"
        />
      </div>
      <div class="campo-filtro">
        <label for="filtro-status" data-i18n="filtroStatus">Status</label>
        <select id="filtro-status">
          <option value="todos" data-i18n="todos">Todos</option>
          <option value="ativo" data-i18n="ativos">Ativos</option>
          <option value="inativo" data-i18n="inativos">Inativos</option>
        </select>
      </div>
    </div>

    <div class="tabela-usuarios-wrap">
      <table class="tabela-usuarios">
        <thead>
          <tr>
            <th scope="col" data-i18n="usuario">Usuário</th>
            <th scope="col" data-i18n="email">E‑mail</th>
            <th scope="col" data-i18n="papel">Papel</th>
            <th scope="col" data-i18n="criadoEm">Criado em</th>
            <th scope="col" data-i18n="lojas">Lojas</th>
            <th scope="col" data-i18n="status">Status</th>
            <th scope="col" style="width: 130px" data-i18n="acao">Ação</th>
          </tr>
        </thead>
        <tbody>
          {usuarios.length === 0 ? (
            <tr>
              <td colspan="7" class="vazio">
                <span data-i18n="nenhumUsuario">Nenhum usuário cadastrado.</span>
              </td>
            </tr>
          ) : (
            usuarios.map((u) => {
              const ativo = u.ativo === 1;
              const ehEu = u.id === usuarioId;
              const master = u.master === 1;
              return (
                <tr class="linha-usuario" data-status={ativo ? 'ativo' : 'inativo'}>
                  <td class="cresce">
                    <span class="titulo-usuario">{u.nome}</span>
                  </td>
                  <td><a href={`mailto:${u.email}`}>{u.email}</a></td>
                  <td>
                    <span class={`badge-papel ${master ? 'badge-master' : 'badge-loja'}`}>
                      {master ? 'Master' : 'Loja'}
                    </span>
                  </td>
                  <td class="celula-data">{formatarData(u.criado_em)}</td>
                  <td>
                    <span class="badge-lojas">{u.qtd_lojas}</span>
                  </td>
                  <td>
                    <span
                      class={`badge-status ${ativo ? 'badge-ativo' : 'badge-inativo'}`}
                      data-i18n={ativo ? 'ativo' : 'inativo'}
                    >
                      {ativo ? 'Ativo' : 'Inativo'}
                    </span>
                  </td>
                  <td class="acoes">
                    {!ehEu && (
                      <form
                        method="post"
                        action="/admin/api/usuarios/toggle-ativo"
                        class="form-toggle"
                        data-confirmar={ativo ? 'Deseja desativar este usuário? Ele perde o acesso ao painel imediatamente.' : 'Deseja ativar este usuário de novo?'}
                      >
                        <input type="hidden" name="id" value={u.id} />
                        <input type="hidden" name="ativo" value={ativo ? '0' : '1'} />
                        <button
                          class={`btn btn-sm ${ativo ? 'btn-perigo' : 'btn-primario'}`}
                          type="submit"
                          data-i18n={ativo ? 'desativar' : 'ativar'}
                        >
                          {ativo ? 'Desativar' : 'Ativar'}
                        </button>
                      </form>
                    )}
                    {ehEu && (
                      <span
                        class="badge-lojas"
                        style="background: transparent; color: var(--adm-dim); font-size: 0.78rem;"
                      >
                        Você
                      </span>
                    )}
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
      {usuarios.length > 0 && (
        <p class="admin-sub" style="margin:10px 0 0">
          <span id="qtd-visiveis">{usuarios.length}</span> usuário(s) visíveis · {totalAtivos} ativo(s) · {totalInativos} inativo(s).
        </p>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  (function () {
    const busca = document.getElementById('busca') as HTMLInputElement | null;
    const filtro = document.getElementById('filtro-status') as HTMLSelectElement | null;
    const linhas = document.querySelectorAll<HTMLElement>('.linha-usuario');
    const visiveis = document.getElementById('qtd-visiveis') as HTMLElement | null;
    if (!busca || !filtro) return;

    function aplicar() {
      const termo = String(busca?.value ?? '').trim().toLowerCase();
      const status = String(filtro?.value ?? 'todos');
      let n = 0;
      linhas.forEach((el) => {
        const texto = (el.textContent ?? '').toLowerCase();
        const statusEl = el.getAttribute('data-status') ?? '';
        const okBusca = termo === '' || texto.includes(termo);
        const okStatus = status === 'todos' || statusEl === status;
        const mostrar = okBusca && okStatus;
        el.style.display = mostrar ? '' : 'none';
        if (mostrar) n++;
      });
      if (visiveis) visiveis.textContent = String(n);
    }

    busca?.addEventListener('input', aplicar);
    filtro?.addEventListener('change', aplicar);

    document.querySelectorAll('.form-toggle').forEach((form) => {
      form.addEventListener('submit', (event) => {
        const msg = form.getAttribute('data-confirmar');
        if (msg && !window.confirm(msg)) {
          event.preventDefault();
        }
      });
    });
  })();
</script>

<style>
  .grade-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    .grade-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    background: var(--adm-card);
    border: 1px solid var(--adm-border);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: inherit;
  }

  .stat-valor {
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1;
    color: #39282c;
    letter-spacing: -0.03em;
  }

  .stat-rotulo {
    font-size: 0.82rem;
    color: #6b7280;
    font-weight: 500;
  }

  .busca-usuarios {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .campo-busca {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .campo-busca input {
    padding: 10px 12px;
    border: 1px solid var(--adm-input-border);
    border-radius: 9px;
    font-size: 15px;
    font-family: inherit;
    background: var(--adm-card);
    color: var(--adm-text);
    box-sizing: border-box;
  }

  .campo-filtro {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .campo-filtro label {
    font-size: 0.8rem;
    color: var(--adm-dim);
    font-weight: 500;
  }

  .campo-filtro select {
    padding: 9px 10px;
    border: 1px solid var(--adm-input-border);
    border-radius: 9px;
    font-size: 0.92rem;
    font-family: inherit;
    background: var(--adm-card);
    color: var(--adm-text);
  }

  .tabela-usuarios-wrap {
    overflow-x: auto;
    margin: 0 -18px;
    padding: 0 18px;
  }

  .tabela-usuarios {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .tabela-usuarios th {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 2px solid var(--adm-border);
    color: var(--adm-dim);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tabela-usuarios td {
    padding: 12px;
    border-bottom: 1px solid var(--adm-border);
    vertical-align: middle;
    color: var(--adm-text);
  }

  .tabela-usuarios tr:last-child td {
    border-bottom: 0;
  }

  .celula-data {
    white-space: normal;
  }

  .titulo-usuario {
    display: block;
    font-weight: 500;
    color: var(--adm-text);
  }

  .badge-lojas {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--adm-elev);
    color: var(--adm-text);
    font-size: 0.82rem;
    font-weight: 500;
    min-width: 28px;
    text-align: center;
    white-space: nowrap;
  }

  .badge-papel {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .badge-master {
    background: #f9df8e;
    color: #39282c;
  }

  .badge-loja {
    background: #e4ebf2;
    color: #4a6a82;
  }

  .badge-status {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .badge-ativo {
    background: #ecf5ee;
    color: #15803d;
  }

  .badge-inativo {
    background: #fbeaea;
    color: #b91c1c;
  }

  .tabela-usuarios a {
    color: #39282c;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .linha-usuario td a:hover {
    text-decoration: none;
  }

  .form-toggle {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .form-toggle .btn-sm {
    padding: 6px 10px;
    font-size: 0.82rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .tabela-usuarios {
      font-size: 0.86rem;
    }
    .celula-data {
      display: none;
    }
  }
</style>
