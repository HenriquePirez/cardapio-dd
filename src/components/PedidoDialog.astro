---
/**
 * Fluxo de compra do cardápio.
 *
 * "Comprar" abre este diálogo:
 * - produto de retirada -> abre o link do app em nova aba;
 * - produto de local   -> mostra o aviso do totem;
 * - produto dos dois    -> pergunta antes.
 */
import type { Modalidade } from '../lib/pedido';

interface Props {
  pedidos: Record<string, { url: string; modalidade: Modalidade; nome: string }>;
  /** Foto opcional do totem; sem ela, mostra um ícone neutro. */
  totemSrc?: string;
}

const { pedidos, totemSrc = '' } = Astro.props;
---

<div
  class="pd"
  id="pedido-dialog"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="pd-titulo-pergunta"
>
  <div class="pd-caixa">
    <button class="pd-fechar" type="button" aria-label="Fechar" data-i18n-aria="fechar">
      &times;
    </button>

    <div class="pd-vista" data-vista="pergunta">
      <p class="pd-produto" id="pd-produto"></p>
      <h2 class="pd-titulo" id="pd-titulo-pergunta" data-i18n="pergunta">
        O pedido é para comer no local ou para retirada?
      </h2>
      <div class="pd-acoes">
        <button class="pd-btn pd-btn-local" type="button" data-escolha="local">
          <span data-i18n="comerLocal">Comer no local</span>
        </button>
        <button class="pd-btn pd-btn-retirada" type="button" data-escolha="retirada">
          <span data-i18n="retirada">Retirada</span>
        </button>
      </div>
      <p class="pd-aviso" data-aviso-link hidden data-i18n="linkIndisponivel">
        Retirada indisponível: o link de compra não está configurado.
      </p>
    </div>

    <div class="pd-vista" data-vista="retirada" hidden>
      <h2 class="pd-titulo" id="pd-titulo-retirada" data-i18n="pedidoAppTitulo">Pedido pelo app</h2>
      <p class="pd-texto" data-i18n="pedidoAppTexto">
        Você será levado ao app de pedidos da loja em outra aba. O pagamento e a entrega são
        combinados lá.
      </p>
      <div class="pd-acoes">
        <button class="pd-btn pd-btn-local" type="button" data-voltar>
          <span data-i18n="voltar">Voltar</span>
        </button>
        <button class="pd-btn pd-btn-retirada" type="button" data-abrir-app>
          <span data-i18n="abrirApp">Abrir app de pedidos</span>
        </button>
      </div>
    </div>

    <div class="pd-vista" data-vista="local" hidden>
      <h2 class="pd-titulo" id="pd-titulo-local" data-i18n="totemTitulo">Peça pelo totem</h2>
      {totemSrc ? (
        <img
          class="pd-totem"
          src={totemSrc}
          alt="Totem de autoatendimento do estabelecimento"
          data-i18n-alt="totemAlt"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="pd-totem-vazio" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="5" y="2.5" width="14" height="19" rx="2"></rect>
            <rect x="8" y="6" width="8" height="7" rx="1"></rect>
            <path d="M8 17h2m4 0h2"></path>
          </svg>
        </div>
      )}
      <p class="pd-texto" data-i18n="totemTexto">
        Pedidos para comer no local são feitos somente no totem local.
      </p>
      <div class="pd-acoes">
        <button class="pd-btn pd-btn-local" type="button" data-voltar>
          <span data-i18n="voltar">Voltar</span>
        </button>
        <button class="pd-btn pd-btn-retirada" type="button" data-fechar>
          <span data-i18n="entendi">Entendi</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="pd-dados" set:html={JSON.stringify(pedidos).replaceAll('<', '\\u003c')} />

<style>
  .pd {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 16px;
    background: rgba(6, 7, 10, 0.72);
    backdrop-filter: blur(4px);
  }

  .pd[hidden] {
    display: none;
  }

  .pd-caixa {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
    border-radius: 18px;
    background: var(--bg-card);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    animation: pd-sobe 0.18s ease;
  }

  @keyframes pd-sobe {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pd-vista[hidden] {
    display: none;
  }

  .pd-fechar {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-dim);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .pd-produto {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pd-titulo {
    margin: 0 0 18px;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .pd-acoes {
    display: grid;
    gap: 10px;
  }

  .pd-btn {
    display: block;
    width: 100%;
    padding: 14px 16px;
    border: 0;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
  }

  .pd-btn-local {
    background: var(--verde);
    color: #fff;
  }

  .pd-btn-retirada {
    background: var(--laranja-aa);
    color: #fff;
  }

  .pd-btn:disabled {
    cursor: not-allowed;
    background: var(--bg-elev);
    color: var(--text-dim);
  }

  .pd-aviso {
    margin: 12px 0 0;
    color: var(--adm-perigo);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .pd-totem {
    width: 100%;
    max-height: 260px;
    margin-bottom: 14px;
    border-radius: 12px;
    object-fit: cover;
  }

  .pd-totem-vazio {
    display: grid;
    place-items: center;
    height: 140px;
    margin-bottom: 14px;
    border-radius: 12px;
    background: var(--bg-elev);
    color: var(--verde);
  }

  .pd-texto {
    margin: 0 0 18px;
    color: var(--text-dim);
    line-height: 1.45;
  }

  @media (min-width: 560px) {
    .pd {
      align-items: center;
    }
  }
</style>

<script>
  import { fluxoDoPedido, normalizarModalidade, urlCompraValida } from '../lib/pedido';

  interface Pedido {
    url: string;
    modalidade: string;
    nome: string;
  }

  const pedidos = JSON.parse(
    document.getElementById('pd-dados')?.textContent || '{}',
  ) as Record<string, Pedido>;

  const pd = document.getElementById('pedido-dialog') as HTMLElement | null;
  const caixa = pd?.querySelector<HTMLElement>('.pd-caixa') ?? null;
  const produtoEl = document.getElementById('pd-produto');
  const btnFechar = pd?.querySelector<HTMLElement>('.pd-fechar');

  let focoAnterior: HTMLElement | null = null;
  let idAtual: string | null = null;
  let fluxoAtual: 'perguntar' | 'local' | 'retirada' = 'perguntar';

  function vista(nome: 'pergunta' | 'local' | 'retirada') {
    pd?.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => {
      v.hidden = v.dataset.vista !== nome;
    });
    pd?.setAttribute('aria-labelledby', `pd-titulo-${nome}`);
  }

  function abrir(id: string) {
    const p = pedidos[id];
    if (!pd || !p) return;

    const modalidade = normalizarModalidade(p.modalidade) ?? 'ambos';
    const fluxo = fluxoDoPedido(modalidade);
    if (fluxo === 'retirada' && !urlCompraValida(p.url)) return;

    idAtual = id;
    fluxoAtual = fluxo;
    focoAnterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    // Suspende o lightbox por baixo para não manter dois aria-modal ativos.
    const lb = document.getElementById('lightbox');
    if (lb && !lb.hasAttribute('hidden')) {
      lb.setAttribute('inert', '');
      lb.removeAttribute('aria-modal');
      lb.dataset.modalSuspenso = '1';
    }
    if (produtoEl) produtoEl.textContent = p.nome;
    vista(fluxo === 'local' ? 'local' : fluxo === 'retirada' ? 'retirada' : 'pergunta');
    pd.hidden = false;
    document.body.style.overflow = 'hidden';

    const retiradaOk = urlCompraValida(p.url);
    pd.querySelectorAll<HTMLElement>('[data-aviso-link]').forEach((el) => {
      el.hidden = retiradaOk;
    });
    const btnRetirada = pd.querySelector<HTMLButtonElement>('[data-escolha="retirada"]');
    if (btnRetirada) {
      btnRetirada.disabled = !retiradaOk;
      btnRetirada.title = retiradaOk ? '' : 'Link de compra não configurado';
    }

    const primeiro = pd.querySelector<HTMLElement>(
      fluxo === 'local' ? '[data-fechar]' : fluxo === 'retirada' ? '[data-abrir-app]' : '[data-escolha]',
    );
    primeiro?.focus();
  }

  function fechar() {
    if (!pd) return;
    pd.hidden = true;
    const lb = document.getElementById('lightbox');
    if (lb?.dataset.modalSuspenso === '1') {
      lb.removeAttribute('inert');
      lb.setAttribute('aria-modal', 'true');
      delete lb.dataset.modalSuspenso;
    }
    // Se o lightbox continuar aberto, ele mantém o scroll travado.
    if (lb?.hasAttribute('hidden') !== false) {
      document.body.style.overflow = '';
    }
    focoAnterior?.focus();
    focoAnterior = null;
  }

  // Delegação: cards, destaque e lightbox usam [data-comprar="<id>"].
  document.addEventListener('click', (e) => {
    const alvo = e.target instanceof Element ? e.target : null;
    const botao = alvo?.closest('[data-comprar]');
    const id = botao?.getAttribute('data-comprar');
    if (!id) return;
    e.preventDefault();
    abrir(id);
  });

  btnFechar?.addEventListener('click', fechar);
  pd?.querySelector('[data-fechar]')?.addEventListener('click', fechar);

  pd?.querySelector('[data-escolha="retirada"]')?.addEventListener('click', () => {
    const p = idAtual ? pedidos[idAtual] : undefined;
    if (!p || !urlCompraValida(p.url)) return;
    vista('retirada');
    pd?.querySelector<HTMLElement>('[data-abrir-app]')?.focus();
  });

  pd?.querySelector('[data-abrir-app]')?.addEventListener('click', () => {
    const p = idAtual ? pedidos[idAtual] : undefined;
    if (p?.url && urlCompraValida(p.url)) window.open(p.url, '_blank', 'noopener');
    fechar();
  });

  pd?.querySelector('[data-escolha="local"]')?.addEventListener('click', () => {
    vista('local');
    pd?.querySelector<HTMLElement>('[data-voltar]')?.focus();
  });

  pd?.querySelectorAll('[data-voltar]').forEach((botao) => {
    botao.addEventListener('click', () => {
      if (fluxoAtual !== 'perguntar') {
        fechar();
        return;
      }
      vista('pergunta');
      pd?.querySelector<HTMLElement>('[data-escolha="local"]')?.focus();
    });
  });



  pd?.addEventListener('click', (e) => {
    if (e.target === pd) fechar();
  });

  document.addEventListener('keydown', (e) => {
    if (!pd || pd.hidden) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      fechar();
      return;
    }
    if (e.key === 'Tab') {
      const focaveis = caixa?.querySelectorAll<HTMLElement>(
        'button:not([hidden]), a[href], [tabindex]:not([tabindex="-1"])',
      );
      if (!focaveis?.length) return;
      const visiveis = [...focaveis].filter(
        (el) => el.offsetParent !== null && !el.hasAttribute('disabled'),
      );
      if (!visiveis.length) return;
      const primeiro = visiveis[0]!;
      const ultimo = visiveis[visiveis.length - 1]!;
      const ativo = document.activeElement;
      if (e.shiftKey && (ativo === primeiro || !caixa?.contains(ativo))) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && ativo === ultimo) {
        e.preventDefault();
        primeiro.focus();
      }
    }
  });
</script>
