---
/**
 * Fluxo de compra do cardápio.
 *
 * "Comprar" abre este diálogo:
 * - produto de retirada -> abre o link do app em nova aba;
 * - produto de local   -> mostra o aviso do totem;
 * - produto dos dois    -> pergunta antes.
 */
import type { Modalidade } from '../lib/pedido';

interface Props {
  pedidos: Record<string, { url: string; modalidade: Modalidade; nome: string }>;
  /** Foto do totem; troque o arquivo em public/ quando a foto real chegar. */
  totemSrc?: string;
}

const { pedidos, totemSrc = '/totem-local.jpg' } = Astro.props;
---

<div
  class="pd"
  id="pedido-dialog"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="pd-titulo"
>
  <div class="pd-caixa">
    <button class="pd-fechar" type="button" aria-label="Fechar">&times;</button>

    <div class="pd-vista" data-vista="pergunta">
      <p class="pd-produto" id="pd-produto"></p>
      <h2 class="pd-titulo" id="pd-titulo">
        O pedido é para comer no local ou para retirada?
      </h2>
      <div class="pd-acoes">
        <button class="pd-btn pd-btn-local" type="button" data-escolha="local">
          Comer no local
        </button>
        <button class="pd-btn pd-btn-retirada" type="button" data-escolha="retirada">
          Retirada
        </button>
      </div>
    </div>

    <div class="pd-vista" data-vista="local" hidden>
      <h2 class="pd-titulo">Peça pelo totem</h2>
      <img
        class="pd-totem"
        src={totemSrc}
        alt="Totem de autoatendimento do estabelecimento"
        loading="lazy"
        decoding="async"
      />
      <p class="pd-texto">
        Pedidos para comer no local são feitos somente no totem local.
      </p>
      <button class="pd-btn pd-btn-retirada" type="button" data-fechar>Entendi</button>
    </div>
  </div>
</div>

<script type="application/json" id="pd-dados" set:html={JSON.stringify(pedidos).replaceAll('<', '\\u003c')} />

<style>
  .pd {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 16px;
    background: rgba(6, 7, 10, 0.72);
    backdrop-filter: blur(4px);
  }

  .pd[hidden] {
    display: none;
  }

  .pd-caixa {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
    border-radius: 18px;
    background: var(--bg-card);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    animation: pd-sobe 0.18s ease;
  }

  @keyframes pd-sobe {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pd-vista[hidden] {
    display: none;
  }

  .pd-fechar {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-dim);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .pd-produto {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pd-titulo {
    margin: 0 0 18px;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .pd-acoes {
    display: grid;
    gap: 10px;
  }

  .pd-btn {
    display: block;
    width: 100%;
    padding: 14px 16px;
    border: 0;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
  }

  .pd-btn-local {
    background: var(--verde);
    color: #fff;
  }

  .pd-btn-retirada {
    background: var(--laranja);
    color: #fff;
  }

  .pd-totem {
    width: 100%;
    max-height: 260px;
    margin-bottom: 14px;
    border-radius: 12px;
    object-fit: cover;
  }

  .pd-texto {
    margin: 0 0 18px;
    color: var(--text-dim);
    line-height: 1.45;
  }

  @media (min-width: 560px) {
    .pd {
      align-items: center;
    }
  }
</style>

<script>
  import { fluxoDoPedido, normalizarModalidade } from '../lib/pedido';

  interface Pedido {
    url: string;
    modalidade: string;
    nome: string;
  }

  const pedidos = JSON.parse(
    document.getElementById('pd-dados')?.textContent || '{}',
  ) as Record<string, Pedido>;

  const pd = document.getElementById('pedido-dialog') as HTMLElement | null;
  const caixa = pd?.querySelector<HTMLElement>('.pd-caixa') ?? null;
  const produtoEl = document.getElementById('pd-produto');
  const btnFechar = pd?.querySelector<HTMLElement>('.pd-fechar');

  let focoAnterior: HTMLElement | null = null;
  let idAtual: string | null = null;

  function vista(nome: 'pergunta' | 'local') {
    pd?.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => {
      v.hidden = v.dataset.vista !== nome;
    });
  }

  function abrir(id: string) {
    const p = pedidos[id];
    if (!pd || !p?.url) return;

    const modalidade = normalizarModalidade(p.modalidade) ?? 'ambos';
    const fluxo = fluxoDoPedido(modalidade);

    if (fluxo === 'retirada') {
      window.open(p.url, '_blank', 'noopener');
      return;
    }

    idAtual = id;
    focoAnterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    if (produtoEl) produtoEl.textContent = p.nome;
    vista(fluxo === 'local' ? 'local' : 'pergunta');
    pd.hidden = false;
    document.body.style.overflow = 'hidden';

    const primeiro = pd.querySelector<HTMLElement>(
      fluxo === 'local' ? '[data-fechar]' : '[data-escolha]',
    );
    primeiro?.focus();
  }

  function fechar() {
    if (!pd) return;
    pd.hidden = true;
    // Se o lightbox continuar aberto, ele mantém o scroll travado.
    if (document.getElementById('lightbox')?.hasAttribute('hidden') !== false) {
      document.body.style.overflow = '';
    }
    focoAnterior?.focus();
    focoAnterior = null;
  }

  // Delegação: cards, destaque e lightbox usam [data-comprar="<id>"].
  document.addEventListener('click', (e) => {
    const alvo = e.target instanceof Element ? e.target : null;
    const botao = alvo?.closest('[data-comprar]');
    const id = botao?.getAttribute('data-comprar');
    if (!id) return;
    e.preventDefault();
    abrir(id);
  });

  btnFechar?.addEventListener('click', fechar);
  pd?.querySelector('[data-fechar]')?.addEventListener('click', fechar);

  pd?.querySelector('[data-escolha="retirada"]')?.addEventListener('click', () => {
    const p = idAtual ? pedidos[idAtual] : undefined;
    if (p?.url) window.open(p.url, '_blank', 'noopener');
    fechar();
  });

  pd?.querySelector('[data-escolha="local"]')?.addEventListener('click', () => {
    vista('local');
    pd?.querySelector<HTMLElement>('[data-fechar]')?.focus();
  });

  // Foto ausente (arquivo ainda não enviado): some com a imagem quebrada.
  pd?.querySelector('img.pd-totem')?.addEventListener('error', (e) => {
    (e.target as HTMLElement).remove();
  });

  pd?.addEventListener('click', (e) => {
    if (e.target === pd) fechar();
  });

  document.addEventListener('keydown', (e) => {
    if (!pd || pd.hidden) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      fechar();
      return;
    }
    if (e.key === 'Tab') {
      const focaveis = caixa?.querySelectorAll<HTMLElement>(
        'button:not([hidden]), a[href], [tabindex]:not([tabindex="-1"])',
      );
      if (!focaveis?.length) return;
      const visiveis = [...focaveis].filter((el) => el.offsetParent !== null);
      if (!visiveis.length) return;
      const primeiro = visiveis[0]!;
      const ultimo = visiveis[visiveis.length - 1]!;
      const ativo = document.activeElement;
      if (e.shiftKey && (ativo === primeiro || !caixa?.contains(ativo))) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && ativo === ultimo) {
        e.preventDefault();
        primeiro.focus();
      }
    }
  });
</script>
