{
  // Nome do Worker (aparece no dashboard do Cloudflare)
  "name": "cardapio-dd",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Build do Astro -> os assets estáticos (CSS/JS) são servidos pelo Worker
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // Banco de dados relacional (categorias, produtos, mídia, usuário)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cardapio-dd",
      "database_id": "c25cc025-285b-4ac1-91c9-3a9a5f0039a9"
    }
  ],

  // Objetos: fotos e vídeos. Usamos KV (free tier, sem cartão) em vez de R2,
  // que exige assinatura com método de pagamento.
  // Limites do plano free: 1 GB total, 25 MB por arquivo, 1.000 escritas/dia.

  // Sessão do login (driver KV provisionado pelo adapter Cloudflare)
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "1037359e715941369e59d52a83501428"
    },
    {
      // Fotos e vídeos enviados pelo painel
      "binding": "MEDIA",
      "id": "224910a2831f4b529d6c031e51453d63"
    }
  ],

  // Variáveis não-sensíveis (secrets vão por `wrangler secret put`)
  "vars": {
    // Base opcional para URLs de mídia. Vazia (padrão): as mídias são servidas
    // por /media/<chave>, lidas do KV pelo Worker. Preencha só se um dia
    // mover as mídias para um host externo (ex: um CDN próprio).
    "MEDIA_PUBLIC_BASE": ""
  }
}
