// Worker de desenvolvimento (branch dev): bindings próprios, nunca os de produção.
// Deploy: `npx wrangler deploy --config wrangler.dev.jsonc`
{
  // Nome do Worker na Cloudflare (aparece no dashboard)
  "name": "cardapio-dd-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Build do Astro -> assets estáticos servidos pelo Worker
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // Banco de dados do dev (separado da produção)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cardapio-dd-dev",
      "database_id": "92f3390f-ac78-4fa7-abc6-9a9977f6036b"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "80f39729496649b59890b82ff4903cea"
    },
    {
      // Fotos e vídeos do ambiente dev
      "binding": "MEDIA",
      "id": "361b7df7f7664b659948136fa5ba7dd1"
    }
  ],

  "vars": {
    "MEDIA_PUBLIC_BASE": ""
  }
}
